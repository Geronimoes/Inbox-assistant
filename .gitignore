# Secrets and credentials — never commit these
config.yaml
config.yaml.*          # config.yaml.bak etc. mirror the secret-bearing config
credentials.json
token.json

# State files containing personal data
data/processed.json
data/project-export-state.json
data/archive-state.json
data/weekly-stats.json

# Writing samples contain real email text — never commit
writing-samples/samples/
writing-samples/curated/*.txt
writing-samples/curated/*.md

# Local crontab backups — contain the full system crontab (all projects); keep local only
cron/backups/

# Generated and transient files
dashboard/index.html
logs/
data/preview.html
data/preview.md
staging/processed/

# Python virtual environments
env/
.env/
.venv/
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Editor
.DS_Store
.vscode/
*.swp
data/obsidian-test/
